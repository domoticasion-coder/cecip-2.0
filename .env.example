# GEMINI_API_KEY: Required for Gemini AI API calls (CeCIP Copilot & Inteligencia Operativa).
# Configured via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Base URL for your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Public anonymous key for client requests with RLS.
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Private service role key for secure backend operations (NEVER send to browser).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
